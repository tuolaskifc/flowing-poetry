{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flowing Poetry scene semantics 3.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "poem",
    "reading",
    "entities",
    "relations",
    "atmosphere",
    "time",
    "uncertainties",
    "spatial"
  ],
  "properties": {
    "schema_version": {
      "const": "3.2"
    },
    "poem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reading": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "entities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mentions",
          "concept",
          "kind",
          "role",
          "presence",
          "evidence",
          "quantity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^i[1-9][0-9]*$"
          },
          "mentions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "enum": [
              "object",
              "organism",
              "person",
              "place",
              "environment",
              "abstract"
            ]
          },
          "role": {
            "enum": [
              "scene",
              "reference"
            ]
          },
          "presence": {
            "enum": [
              "present",
              "absent",
              "unclear"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "quantity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "min",
              "max",
              "unit",
              "scope",
              "extent",
              "evidence"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "exact",
                  "range",
                  "few",
                  "many",
                  "unspecified"
                ]
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope": {
                "enum": [
                  "individual",
                  "part",
                  "group",
                  "extent",
                  "unspecified"
                ]
              },
              "extent": {
                "enum": [
                  "local",
                  "spread",
                  "unspecified"
                ]
              },
              "evidence": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "source",
          "target",
          "meaning",
          "modality",
          "basis",
          "evidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "acts_on",
              "moves",
              "moves_toward",
              "moves_away",
              "carries",
              "grows_from",
              "disappears",
              "changes",
              "obscures",
              "located_in",
              "compared_to",
              "contrasts_with",
              "corresponds_with",
              "observes",
              "other"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^i[1-9][0-9]*$"
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^i[1-9][0-9]*$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "modality": {
            "enum": [
              "asserted",
              "negated",
              "possible",
              "conditional",
              "unclear"
            ]
          },
          "basis": {
            "enum": [
              "explicit",
              "inferred"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "valence",
        "energy",
        "tension",
        "openness",
        "evidence"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          }
        },
        "energy": {
          "enum": [
            "low",
            "medium",
            "high",
            "unclear"
          ]
        },
        "tension": {
          "enum": [
            "low",
            "medium",
            "high",
            "unclear"
          ]
        },
        "openness": {
          "enum": [
            "low",
            "medium",
            "high",
            "unclear"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "valence": {
          "enum": [
            "positive",
            "neutral",
            "negative",
            "mixed",
            "unclear"
          ]
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markers",
        "note"
      ],
      "properties": {
        "markers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "meaning"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "spatial": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "source",
          "target",
          "modality",
          "basis",
          "evidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "on",
              "beside",
              "behind",
              "in_front_of",
              "outside",
              "among",
              "reflects_on"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^i[1-9][0-9]*$"
          },
          "target": {
            "type": "string",
            "pattern": "^i[1-9][0-9]*$"
          },
          "modality": {
            "enum": [
              "asserted",
              "negated",
              "possible",
              "conditional",
              "unclear"
            ]
          },
          "basis": {
            "enum": [
              "explicit",
              "inferred"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    }
  }
}
