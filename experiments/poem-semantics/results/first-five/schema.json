{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poem semantic analysis; no drawing instructions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "poem", "core_reading", "imagery", "relations", "mood", "temporal", "uncertainties"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "poem": {"type": "string", "minLength": 1, "maxLength": 200},
    "core_reading": {"type": "string", "minLength": 1, "maxLength": 160},
    "imagery": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "surface", "concept", "kind", "presence", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^i[1-9][0-9]*$"},
          "surface": {"type": "string", "minLength": 1, "maxLength": 40},
          "concept": {"type": "string", "minLength": 1, "maxLength": 100},
          "kind": {"enum": ["object", "environment", "place", "person"]},
          "presence": {"enum": ["literal", "figurative_reference", "inferred", "uncertain"]},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "relations": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "target", "type", "description", "evidence"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": ["string", "null"]},
          "type": {"enum": ["acts_on", "moves_toward", "moves_away", "located_in", "compared_to", "contrasts_with", "precedes", "corresponds_with", "obscures", "persists"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 160},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "mood": {
      "type": "object", "additionalProperties": false,
      "required": ["labels", "energy", "tension", "spatial_openness", "explanation", "evidence"],
      "properties": {
        "labels": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 16}},
        "energy": {"$ref": "#/$defs/level"},
        "tension": {"$ref": "#/$defs/level"},
        "spatial_openness": {"$ref": "#/$defs/level"},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 200},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "temporal": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "description", "evidence"],
      "properties": {
        "mode": {"enum": ["continuous", "cyclic", "progressive", "suspended", "unspecified"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 160},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "uncertainties": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["topic", "alternatives", "reason"],
        "properties": {
          "topic": {"type": "string", "minLength": 1, "maxLength": 80},
          "alternatives": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  },
  "$defs": {
    "evidence": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "level": {"enum": ["low", "medium", "high", "unclear"]}
  }
}
